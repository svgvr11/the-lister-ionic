{
  "name": "the-lister-ionic",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test:board-merge": "node --experimental-strip-types scripts/test-board-merge.mjs",
    "test:session-order": "node --experimental-strip-types scripts/test-session-order.mjs",
    "test:session-guard": "node --experimental-strip-types scripts/test-session-guard.mjs",
    "test:board-theme": "node --experimental-strip-types scripts/test-board-theme.mjs",
    "test:archive": "node --experimental-strip-types scripts/test-archive.mjs",
    "test:feedback": "node --experimental-strip-types scripts/test-feedback.mjs",
    "test:delete-account": "node --experimental-strip-types scripts/test-delete-account.mjs",
    "test:delete-account-result": "node --experimental-strip-types scripts/test-delete-account-result.mjs",
    "test:google-auth": "node --experimental-strip-types scripts/test-google-auth.mjs",
    "test:version": "node --experimental-strip-types scripts/test-version.mjs",
    "test:android-version": "node --experimental-strip-types scripts/test-android-version.mjs",
    "test:apk-name": "node --experimental-strip-types scripts/test-apk-name.mjs",
    "test:list-title": "node --experimental-strip-types scripts/test-list-title.mjs",
    "test:overlay-stack": "node --experimental-strip-types scripts/test-overlay-stack.mjs",
    "test:board-sync": "node --experimental-strip-types scripts/test-board-sync.mjs",
    "test:focus-notice": "node --experimental-strip-types scripts/test-focus-notice.mjs",
    "test:inline-edit": "node --experimental-strip-types scripts/test-inline-edit.mjs",
    "test:edit-contrast": "node --experimental-strip-types scripts/test-edit-contrast.mjs",
    "test:masonry": "node --experimental-strip-types scripts/test-masonry.mjs",
    "test:board-view": "node --experimental-strip-types scripts/test-board-view.mjs",
    "test:login-spinner": "node --experimental-strip-types scripts/test-login-spinner.ts",
    "version:bump": "node scripts/bump-version.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "apk": "npm run build && node scripts/android-version.mjs && cap sync android && cd android && ./gradlew assembleDebug && node ../scripts/name-apk.mjs",
    "bundle": "node --experimental-strip-types scripts/bundle.mjs",
    "bundle:check": "jarsigner -verify -verbose -certs android/app/build/outputs/bundle/release/app-release.aab"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
