{
  "name": "the-lister-ionic",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test:feedback": "node --experimental-strip-types scripts/test-feedback.mjs",
    "test:delete-account": "node --experimental-strip-types scripts/test-delete-account.mjs",
    "test:version": "node --experimental-strip-types scripts/test-version.mjs",
    "test:android-version": "node --experimental-strip-types scripts/test-android-version.mjs",
    "test:apk-name": "node --experimental-strip-types scripts/test-apk-name.mjs",
    "test:legacy": "npm run test:feedback && npm run test:delete-account && npm run test:version && npm run test:android-version && npm run test:apk-name",
    "version:bump": "node scripts/bump-version.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "apk": "npm run build && node scripts/android-version.mjs && cap sync android && cd android && ./gradlew assembleDebug && node ../scripts/name-apk.mjs",
    "bundle": "node --experimental-strip-types scripts/bundle.mjs",
    "bundle:check": "jarsigner -verify -verbose -certs android/app/build/outputs/bundle/release/app-release.aab"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@ionic/angular": "^8.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "ionicons": "^7.4.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  }
}
